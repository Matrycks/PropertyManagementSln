@model RentalUnitModel

<div class="card border rounded-3 mb-3">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
            <div class="text-end">
                <div class="text-muted small">UNIT</div>
                <div class="fw-semibold">@Model.UnitNumber</div>
            </div>
        </div>

        @if (Model.FloorPlan != null)
        {
            <hr class="my-2" />

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <div class="text-muted small">FLOOR PLAN</div>
                    <div class="fw-semibold">@Model.FloorPlan.Name</div>
                </div>

                <div class="d-flex flex-wrap gap-3">
                    <div>
                        <div class="text-muted small">Beds</div>
                        <div class="fw-medium">
                            @Model.FloorPlan.Bedrooms
                        </div>
                    </div>

                    <div>
                        <div class="text-muted small">Baths</div>
                        <div class="fw-medium">
                            @Model.FloorPlan.Bathrooms.ToString("0.##")
                        </div>
                    </div>

                    <div>
                        <div class="text-muted small">Sq Ft</div>
                        <div class="fw-medium">
                            @Model.FloorPlan.SquareFeet.ToString("N0")
                        </div>
                    </div>

                    <div>
                        <div class="text-muted small">Monthly Rent</div>
                        <div class="fw-semibold text-success">
                            @Model.FloorPlan.Rent.ToString("C")
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (ViewBag.ShowActions == true)
        {
            <hr class="my-3" />

            <div class="d-grid">
                <a asp-controller="RentalApplication" asp-action="Index" asp-route-rentalUnitId="@Model.RentalUnitId"
                   class="btn btn-primary">
                    Start Application
                </a>
            </div>
        }
    </div>
</div>

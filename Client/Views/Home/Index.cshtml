<!-- How It Works -->
<section id="how-it-works" class="py-5 bg-light">

    <div class="container py-4">

        <div class="text-center mb-5">

            <h2 class="fw-bold">
                Finding your new home is easy
            </h2>

            <p class="text-muted">
                Three simple steps to get started.
            </p>

        </div>


        <div class="row g-4 text-center">

            <div class="col-md-4">

                <div class="mb-3">

                    <span class="rounded-circle bg-primary text-white
                        d-inline-flex align-items-center
                        justify-content-center fw-bold fs-4" style="width:60px;height:60px;">
                        1
                    </span>

                </div>

                <h5 class="fw-bold">
                    Search
                </h5>

                <p class="text-muted">
                    Search apartment communities by location,
                    bedrooms, and budget.
                </p>

            </div>


            <div class="col-md-4">

                <div class="mb-3">

                    <span class="rounded-circle bg-primary text-white
                        d-inline-flex align-items-center
                        justify-content-center fw-bold fs-4" style="width:60px;height:60px;">
                        2
                    </span>

                </div>

                <h5 class="fw-bold">
                    Compare
                </h5>

                <p class="text-muted">
                    Review floor plans, amenities, pricing,
                    and availability.
                </p>

            </div>


            <div class="col-md-4">

                <div class="mb-3">

                    <span class="rounded-circle bg-primary text-white
                        d-inline-flex align-items-center
                        justify-content-center fw-bold fs-4" style="width:60px;height:60px;">
                        3
                    </span>

                </div>

                <h5 class="fw-bold">
                    Apply
                </h5>

                <p class="text-muted">
                    Choose your apartment and start your
                    rental application.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- Call to Action -->
<section class="py-5">

    <div class="container">

        <div class="bg-primary text-white rounded-4

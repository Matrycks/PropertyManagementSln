@using Microsoft.EntityFrameworkCore.Metadata.Internal
@model RentalPropertyModel
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider

@{
    ViewData["Title"] = $"{@Model.Name} - Details";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Rental Property Details</h2>
            <p class="text-muted mb-0">
                View property information and rental units.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="RentalProperties" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
            <button type="button" class="btn btn-primary"
                id="editPropertyBtn" data-bs-toggle="modal" data-bs-target="#propertyModal"
                data-id="@Model.RentalPropertyId">
                <i class="bi bi-pencil"></i> Edit Property
            </button>
        </div>
    </div>

    <!-- Property Information -->
    <div id="basicPropertyDetailsContainer">
        @await Component.InvokeAsync("RentalPropertyDetails", Model)
    </div>

    <!-- Rental Units -->
    <div class="card shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Rental Units</h5>

            <span class="badge bg-primary">
                @(Model.RentalUnits?.Count ?? 0) Units
            </span>
        </div>

        <div class="card-body">
            <div class="row g-4">
                @if (Model.RentalUnits != null && Model.RentalUnits.Any())
                {
                    @foreach (var unit in Model.RentalUnits)
                    {
                        @await Component.InvokeAsync("RentalUnitDetails", unit)
                        
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-building display-4 text-muted"></i>
                        <h5 class="mt-3">No Rental Units</h5>
                        <p class="text-muted mb-3">
                            No rental units have been added to this property yet.
                        </p>
                        <button type="button"
                            class="btn btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#unitModal">
                            Add Rental Unit
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<partial name="_PropertyModals"/>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script
    src="@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/js/rental-property.js"))"></script>
}
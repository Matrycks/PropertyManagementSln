@model IEnumerable<RentalPropertyModel>
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider

@{
    ViewData["Title"] = "Rental Properties";
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Rental Properties</h2>
            <p class="text-muted mb-0">
                Browse our available apartment communities.
            </p>
        </div>

        <div class="mt-3 mt-md-0">
            <span class="badge bg-light text-dark border fs-6 px-3 py-2">
                @Model.Count() Properties
            </span>
        </div>

    </div>


    <!-- Search -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

            <form method="get">

                <div class="row g-3">

                    <div class="col-md-9">
                        <label class="form-label fw-semibold">
                            Search Properties
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text" name="search" class="form-control"
                                   placeholder="Search by property name, city, or ZIP code..." value="" />

                        </div>
                    </div>

                    <div class="col-md-3 d-flex align-items-end">

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search me-1"></i>
                            Search
                        </button>

                    </div>

                </div>

            </form>

        </div>
    </div>

    <div class="d-flex justify-content-end mb-4">
        <button id="addPropertyBtn" class="btn btn-outline-primary"
            data-bs-toggle="modal"
            data-bs-target="#propertyModal">
            <i class="bi bi-plus-lg me-1"></i>
            + Add Property
        </button>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @success
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @error
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Properties -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var property in Model)
            {
                <div class="col-md-6 col-xl-4">

                    <div class="card h-100 border-0 shadow-sm">

                        <!-- Property Image Placeholder -->
                        <div class="bg-light d-flex
                            align-items-center
                            justify-content-center" style="height:220px;">

                            <i class="bi bi-buildings text-secondary" style="font-size:5rem;">
                                Image
                            </i>

                        </div>


                        <!-- Property Information -->
                        <div class="card-body p-4">

                            <div class="d-flex
                                justify-content-between
                                align-items-start
                                mb-2">

                                <h5 class="card-title fw-bold mb-0">
                                    @property.Name
                                </h5>

                                @if (property.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }

                            </div>


                            <!-- Address -->
                            <div class="text-muted mb-3">

                                <i class="bi bi-geo-alt me-1"></i>

                                <span>
                                    @property.Address<br />
                                    @property.City,
                                    @property.State
                                    @property.ZipCode
                                </span>

                            </div>


                            <!-- Description -->
                            <p class="card-text text-muted">

                                @if (!string.IsNullOrWhiteSpace(property.Description))
                                {
                                    @(property.Description.Length > 120
                                        ? property.Description.Substring(0, 120) + "..."
                                        : property.Description)
                                }
                                else
                                {
                                    <span>
                                        No description available.
                                    </span>
                                }

                            </p>


                            <hr />


                            <!-- Unit Information -->
                            <div class="row text-center g-2 mb-3">

                                <div class="col-6">

                                    <div class="border rounded p-2">

                                        <div class="fw-bold fs-5">
                                            @property.TotalUnits
                                        </div>

                                        <div class="small text-muted">
                                            Total Units
                                        </div>

                                    </div>

                                </div>


                                <div class="col-6">

                                    <div class="border rounded p-2">

                                        <div class="fw-bold fs-5 text-success">
                                            @property.AvailableUnits
                                        </div>

                                        <div class="small text-muted">
                                            Available
                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- Actions -->
                            <div class="d-flex gap-2">

                                <a asp-action="RentalPropertyDetails" asp-route-propertyId="@property.RentalPropertyId"
                                   class="btn btn-outline-primary flex-fill">

                                    <i class="bi bi-eye me-1"></i>
                                    View Details

                                </a>

                                <form asp-action="Delete" 
                                    asp-route-propertyId="@property.RentalPropertyId" 
                                    method="post"
                                    class="flex-fill"
                                    onsubmit="showConfirmModal(event, 'Are you sure you want to delete property @property.Name?');">
                                    
                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-outline-danger w-100">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <i class="bi bi-buildings text-muted" style="font-size:5rem;">
                </i>

                <h4 class="mt-3">
                    No Rental Properties Found
                </h4>

                <p class="text-muted mb-4">
                    There are currently no rental properties to display.
                </p>

                <a asp-action="Create" class="btn btn-primary">

                    <i class="bi bi-plus-lg me-1"></i>
                    Add Rental Property

                </a>

            </div>

        </div>
    }

</div>

<partial name="_PropertyModals"/>

@section Scripts {
    <script
    src="@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/js/rental-property.js"))"></script>
}
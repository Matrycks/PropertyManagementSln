<!-- Add/Edit property Modal -->
<div class="modal fade" id="propertyModal" tabindex="-1"
     aria-labelledby="propertyModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="propertyForm" method="post"
                  asp-controller="RentalProperty" asp-action="Create">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title" id="propertyModalTitle">
                        Add Property
                    </h5>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="RentalPropertyId" id="propertyId" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="propertyName" class="form-label">
                                Property Name
                            </label>
                            <input class="form-control" id="propertyName"
                                   name="Name" required maxlength="150" />
                        </div>

                        <div class="col-md-6">
                            <label for="propertyAddress" class="form-label">
                                Address
                            </label>
                            <input class="form-control" id="propertyAddress"
                                   name="Address" required maxlength="200" />
                        </div>

                        <div class="col-md-6">
                            <label for="propertyCity" class="form-label">City</label>
                            <input class="form-control" id="propertyCity"
                                   name="City" required maxlength="100" />
                        </div>

                        <div class="col-md-3">
                            <label for="propertyState" class="form-label">State</label>
                            <input class="form-control" id="propertyState"
                                   name="State" required maxlength="50" />
                        </div>

                        <div class="col-md-3">
                            <label for="propertyZipCode" class="form-label">
                                ZIP Code
                            </label>
                            <input class="form-control" id="propertyZipCode"
                                   name="ZipCode" required maxlength="10" />
                        </div>

                        <div class="col-12">
                            <label for="propertyDescription" class="form-label">
                                Description
                            </label>
                            <textarea class="form-control"
                                      id="propertyDescription"
                                      name="Description" rows="3"></textarea>
                        </div>

                        <div class="col-12" id="propertyActiveContainer" hidden>
                            <input type="hidden" name="IsActive" value="false" />
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       id="propertyIsActive" name="IsActive"
                                       value="true" checked />
                                <label class="form-check-label"
                                       for="propertyIsActive">
                                    Active property
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Property</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add/Edit Unit Modal -->
<div class="modal fade" id="unitModal" tabindex="-1" aria-labelledby="unitModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="unitForm" method="post" asp-controller="RentalUnit" asp-action="Create">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title" id="unitModalTitle">Add Unit</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="RentalUnitId" id="unitId" />
                    <input type="hidden" name="RentalPropertyId" id="unitPropertyId" />

                    <p class="text-muted">
                        Property: <strong id="unitPropertyName"></strong>
                    </p>

                    <div class="mb-3">
                        <label for="unitNumber" class="form-label">
                            Unit Number
                        </label>
                        <input class="form-control" id="unitNumber" name="UnitNumber" required maxlength="20" />
                    </div>

                    <div class="mb-3">
                        <label for="floorPlanId" class="form-label">
                            Unit Type / Floor Plan
                        </label>
                        <select class="form-select" id="floorPlanId" name="FloorPlanId" required>
                            <option value="">Select a floor plan</option>
                            @* @foreach (var plan in Model.FloorPlans)
                            {
                                <option value="@plan.Value">@plan.Text</option>
                            } *@
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="unitRent" class="form-label">
                            Monthly Rent
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control" id="unitRent" name="Rent" min="0.01" max="1000000"
                                   step="0.01" required />
                        </div>
                    </div>

                    <div class="form-check" id="unitOccupiedContainer" hidden>
                        <input class="form-check-input" type="checkbox" id="unitIsOccupied" name="IsOccupied"
                               value="true" />
                        <label class="form-check-label" for="unitIsOccupied">
                            Unit is occupied
                        </label>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Unit</button>
                </div>
            </form>
        </div>
    </div>
</div>
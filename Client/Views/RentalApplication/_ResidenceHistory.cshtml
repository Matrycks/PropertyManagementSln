@model List<ResidenceHistoryModel>

<h4 class="fw-bold mb-1">
    Residence History
</h4>

<p class="text-muted mb-4">
    Please provide your previous residences.
</p>

<div id="residenceList">
    @if (Model.Count == 0)
    {
        <div class="alert alert-light border" id="emptyResidenceMessage">
            <i class="bi bi-info-circle me-2"></i>
            No previous residences have been added.
        </div>
    }

    @for (var i = 0; i < Model.Count; i++)
    {
        <div class="card mb-3 residence-card" data-index="@i">

            <div class="card-body">
                <strong>@Model[i].Address</strong>
                <div>@Model[i].City, @Model[i].State @Model[i].ZipCode</div>

                <button type="button" class="btn btn-sm btn-primary edit-residence">
                    Edit
                </button>

                <button type="button" class="btn btn-sm btn-danger delete-residence">
                    Delete
                </button>
            </div>

            <input type="hidden" name="ResidenceHistory[@i].ResidenceHistoryId" value="@Model[i].ResidenceHistoryId" />

            <input type="hidden" name="ResidenceHistory[@i].ApplicantId" value="@Model[i].ApplicantId" />

            <input type="hidden" name="ResidenceHistory[@i].Address" value="@Model[i].Address" />

            <input type="hidden" name="ResidenceHistory[@i].City" value="@Model[i].City" />

            <input type="hidden" name="ResidenceHistory[@i].State" value="@Model[i].State" />

            <input type="hidden" name="ResidenceHistory[@i].ZipCode" value="@Model[i].ZipCode" />

            <input type="hidden" name="ResidenceHistory[@i].MoveInDate"
                   value="@Model[i].MoveInDate.ToString("yyyy-MM-dd")" />

            <input type="hidden" name="ResidenceHistory[@i].MoveOutDate"
                   value="@Model[i].MoveOutDate?.ToString("yyyy-MM-dd")" />

            <input type="hidden" name="ResidenceHistory[@i].LandlordName" value="@Model[i].LandlordName" />

            <input type="hidden" name="ResidenceHistory[@i].LandlordPhone" value="@Model[i].LandlordPhone" />
        </div>
    }
</div>

@if (Model.Count < 5)
{
    <button type="button" id="addResidenceBtn" class="btn btn-outline-primary" data-bs-toggle="modal"
            data-bs-target="#residenceModal">
        <i class="bi bi-plus-lg me-1"></i>
        Add Previous Residence
    </button>
}

<!-- Add/Edit Modal -->
<div class="modal fade" id="residenceModal" tabindex="-1" aria-labelledby="residenceModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div id="residenceForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="residenceModalTitle">
                        Add Previous Residence
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="ResidenceHistoryId" name="ResidenceHistoryId" value="0" />

                    <input type="hidden" id="ApplicantId" name="ApplicantId" value="" />

                    <div id="residenceFormError" class="alert alert-danger d-none"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label for="Address" class="form-label">Address</label>
                            <input id="Address" name="Address" class="form-control" required maxlength="200" />
                            <span class="text-danger" data-error-for="Address"></span>
                        </div>

                        <div class="col-md-6">
                            <label for="City" class="form-label">City</label>
                            <input id="City" name="City" class="form-control" required maxlength="100" />
                            <span class="text-danger" data-error-for="City"></span>
                        </div>

                        <div class="col-md-3">
                            <label for="State" class="form-label">State</label>
                            <input id="State" name="State" class="form-control" required maxlength="2" />
                            <span class="text-danger" data-error-for="State"></span>
                        </div>

                        <div class="col-md-3">
                            <label for="ZipCode" class="form-label">ZIP Code</label>
                            <input id="ZipCode" name="ZipCode" class="form-control" required
                                   pattern="[0-9]{5}(-[0-9]{4})?" />
                            <span class="text-danger" data-error-for="ZipCode"></span>
                        </div>

                        <div class="col-md-6">
                            <label for="MoveInDate" class="form-label">Move-in Date</label>
                            <input id="MoveInDate" name="MoveInDate" type="date" class="form-control" required />
                            <span class="text-danger" data-error-for="MoveInDate"></span>
                        </div>

                        <div class="col-md-6">
                            <label for="MoveOutDate" class="form-label">Move-out Date</label>
                            <input id="MoveOutDate" name="MoveOutDate" type="date" class="form-control" />
                            <span class="text-danger" data-error-for="MoveOutDate"></span>
                        </div>

                        <div class="col-md-6">
                            <label for="LandlordName" class="form-label">Landlord Name</label>
                            <input id="LandlordName" name="LandlordName" class="form-control" required
                                   maxlength="150" />
                            <span class="text-danger" data-error-for="LandlordName"></span>
                        </div>

                        <div class="col-md-6">
                            <label for="LandlordPhone" class="form-label">Landlord Phone</label>
                            <input id="LandlordPhone" name="LandlordPhone" type="tel" class="form-control" required />
                            <span class="text-danger" data-error-for="LandlordPhone"></span>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="saveResidenceBtn" class="btn btn-primary">
                        Save Residence
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@model List<ResidenceHistoryModel>

<h4 class="fw-bold mb-1">
    Residence History
</h4>

<p class="text-muted mb-4">
    Please provide your previous residences.
</p>

<div id="residenceList">
    @if (Model.Count == 0)
    {
        <div class="alert alert-light border" id="emptyResidenceMessage">
            <i class="bi bi-info-circle me-2"></i>
            No previous residences have been added.
        </div>
    }

    @for (var i = 0; i < Model.Count; i++)
    {
        <div class="card mb-3 residence-card" data-index="@i">

            <div class="card-body">
                <strong>@Model[i].Address</strong>
                <div>@Model[i].City, @Model[i].State @Model[i].ZipCode</div>

                <button type="button" class="btn btn-sm btn-primary btn-edit-residence" data-bs-toggle="modal"
                        data-bs-target="#residenceModal" data-index="@i">
                    Edit
                </button>

                <button type="button" class="btn btn-sm btn-danger btn-delete-residence">
                    Delete
                </button>
            </div>

            <!-- Hidden form fields -->
            <input type="hidden" name="ResidenceHistory[@i].ResidenceHistoryId" value="@Model[i].ResidenceHistoryId" />

            <input type="hidden" name="ResidenceHistory[@i].UserId" value="@Model[i].UserId" />

            <input type="hidden" name="ResidenceHistory[@i].Address" value="@Model[i].Address" />

            <input type="hidden" name="ResidenceHistory[@i].City" value="@Model[i].City" />

            <input type="hidden" name="ResidenceHistory[@i].State" value="@Model[i].State" />

            <input type="hidden" name="ResidenceHistory[@i].ZipCode" value="@Model[i].ZipCode" />

            <input type="hidden" name="ResidenceHistory[@i].MoveInDate"
                   value="@Model[i].MoveInDate.ToString("yyyy-MM-dd")" />

            <input type="hidden" name="ResidenceHistory[@i].MoveOutDate"
                   value="@Model[i].MoveOutDate?.ToString("yyyy-MM-dd")" />

            <input type="hidden" name="ResidenceHistory[@i].LandlordName" value="@Model[i].LandlordName" />

            <input type="hidden" name="ResidenceHistory[@i].LandlordPhone" value="@Model[i].LandlordPhone" />
        </div>
    }
</div>

@if (Model.Count < 5)
{
    <button type="button" id="addResidenceBtn" class="btn btn-outline-primary" data-bs-toggle="modal"
            data-bs-target="#residenceModal">
        <i class="bi bi-plus-lg me-1"></i>
        Add Previous Residence
    </button>
}

<!-- Add/Edit Modal -->
<div class="modal fade" id="residenceModal" tabindex="-1" aria-labelledby="residenceModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div id="residenceForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="residenceModalTitle">
                        Add Previous Residence
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="ResidenceHistoryId" name="ResidenceHistoryId" value="0" />
                    <input type="hidden" id="ResidenceHistoryIndex" name="ResidenceHistoryIndex" value="" />

                    <input type="hidden" id="ApplicantId" name="ApplicantId" value="" />

                    <div id="residenceFormError" class="alert alert-danger d-none"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label for="resAddress" class="form-label">Address</label>
                            <input id="resAddress" name="resAddress" class="form-control" required maxlength="200" />
                            <span class="text-danger" data-error-for="resAddress"></span>
                        </div>

                        <div class="col-md-6">
                            <label for="resCity" class="form-label">City</label>
                            <input id="resCity" name="resCity" class="form-control" required maxlength="100" />
                            <span class="text-danger" data-error-for="resCity"></span>
                        </div>

                        <div class="col-md-3">
                            <label for="resState" class="form-label">State</label>
                            <input id="resState" name="resState" class="form-control" required maxlength="2" />
                            <span class="text-danger" data-error-for="resState"></span>
                        </div>

                        <div class="col-md-3">
                            <label for="resZipCode" class="form-label">ZIP Code</label>
                            <input id="resZipCode" name="resZipCode" class="form-control" required
                                   pattern="[0-9]{5}(-[0-9]{4})?" />
                            <span class="text-danger" data-error-for="resZipCode"></span>
                        </div>

                        <div class="col-md-6">
                            <label for="resMoveInDate" class="form-label">Move-in Date</label>
                            <input id="resMoveInDate" name="resMoveInDate" type="date" class="form-control" required />
                            <span class="text-danger" data-error-for="resMoveInDate"></span>
                        </div>

                        <div class="col-md-6">
                            <label for="resMoveOutDate" class="form-label">Move-out Date</label>
                            <input id="resMoveOutDate" name="resMoveOutDate" type="date" class="form-control" />
                            <span class="text-danger" data-error-for="resMoveOutDate"></span>
                        </div>

                        <div class="col-md-6">
                            <label for="resLandlordName" class="form-label">Landlord Name</label>
                            <input id="resLandlordName" name="resLandlordName" class="form-control" required
                                   maxlength="150" />
                            <span class="text-danger" data-error-for="resLandlordName"></span>
                        </div>

                        <div class="col-md-6">
                            <label for="resLandlordPhone" class="form-label">Landlord Phone</label>
                            <input id="resLandlordPhone" name="resLandlordPhone" type="tel" class="form-control"
                                   required />
                            <span class="text-danger" data-error-for="resLandlordPhone"></span>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="saveResidenceBtn" class="btn btn-primary">
                        Save Residence
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

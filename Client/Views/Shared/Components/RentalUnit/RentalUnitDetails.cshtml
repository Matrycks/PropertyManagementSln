@model RentalUnitModel

<div class="col-12 col-md-6 col-lg-4">
    <div class="card h-100 shadow-sm">

        <div class="bg-light d-flex
            align-items-center
            justify-content-center" style="height:220px;">

            <i class="bi bi-buildings text-secondary" style="font-size:5rem;">
                Image
            </i>

        </div>

        <div class="card-body">
            <div class="d-flex justify-content-between
                align-items-start mb-2">
                <h5 class="card-title mb-0">
                    Unit @Model.UnitNumber
                </h5>

                @if (Model.IsOccupied)
                {
                    <span class="badge bg-secondary">
                        Occupied
                    </span>
                }
                else
                {
                    <span class="badge bg-success">
                        Available
                    </span>
                }
            </div>

            <h6 class="text-muted mb-3">
                @Model.FloorPlan.Name
            </h6>

            <div class="row text-center mb-3">
                <div class="col-4">
                    <strong>
                        @Model.FloorPlan.Bedrooms
                    </strong>
                    <div class="small text-muted">
                        Bedrooms
                    </div>
                </div>

                <div class="col-4">
                    <strong>
                        @Model.FloorPlan.Bathrooms
                    </strong>
                    <div class="small text-muted">
                        Bathrooms
                    </div>
                </div>

                <div class="col-4">
                    <strong>
                        @Model.FloorPlan.SquareFeet.ToString("N0")
                    </strong>
                    <div class="small text-muted">
                        Sq. Ft.
                    </div>
                </div>
            </div>

            <hr />

            <div class="d-flex justify-content-between
                align-items-center">
                <div>
                    <div class="small text-muted">
                        Monthly Rent
                    </div>
                    <h4 class="text-primary mb-0">
                        @Model.Rent.ToString("C")
                        <small class="fs-6 text-muted">
                            /mo
                        </small>
                    </h4>
                </div>

                <span class="badge bg-light text-dark">
                    @Model.FloorPlan.Name
                </span>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button id="editUnitBtn" class="btn btn-outline-primary btn-sm flex-fill btn-edit-unit"
                        data-bs-toggle="modal" data-bs-target="#unitModal" data-id="@Model.RentalUnitId">
                    <i class="bi bi-pencil"></i> Edit
                </button>

                <form asp-controller="RentalUnit" asp-action="Delete" asp-route-rentalUnitId="@Model.RentalUnitId"
                      asp-route-rentalPropertyId="@Model.RentalPropertyId" method="post" class="flex-fill"
                      onsubmit="showConfirmModal(event, 'Are you sure you want to delete unit @Model.UnitNumber?');">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
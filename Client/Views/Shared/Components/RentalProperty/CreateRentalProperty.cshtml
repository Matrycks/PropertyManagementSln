@model RentalPropertyModel

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12">

            <div class="d-flex align-items-center mb-4">
                <div>
                    <p class="text-muted mb-0">
                        Enter the details for your rental property.
                    </p>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">

                    <form asp-action="SaveProperty" method="post" class="ajax-form">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <h5 class="mb-3">Property Information</h5>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">
                                Property Name
                            </label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Oakwood Apartments" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label">
                                Street Address
                            </label>
                            <input asp-for="Address" class="form-control" placeholder="123 Main Street" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="City" class="form-label">
                                    City
                                </label>
                                <input asp-for="City" class="form-control" placeholder="City" />
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="State" class="form-label">
                                    State
                                </label>
                                <input asp-for="State" class="form-control" placeholder="FL" />
                                <span asp-validation-for="State" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="ZipCode" class="form-label">
                                    ZIP Code
                                </label>
                                <input asp-for="ZipCode" class="form-control" placeholder="33578" />
                                <span asp-validation-for="ZipCode" class="text-danger"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <h5 class="mb-3">Additional Details</h5>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">
                                Description
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="4"
                                      placeholder="Describe the property, amenities, and other details..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input asp-for="IsActive" class="form-check-input" role="switch" />
                            <label asp-for="IsActive" class="form-check-label">
                                Active Property
                            </label>
                            <div class="form-text">
                                Active properties can be shown as available
                                for management and listing.
                            </div>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i>
                                Save Property
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
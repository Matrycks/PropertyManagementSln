@model FloorPlanModel

<div class="card h-100 border-0 shadow-sm overflow-hidden">

    <!-- Floor Plan Image -->
    <div class="bg-light" style="height: 260px;">

        @if (!string.IsNullOrWhiteSpace(@Model.PictureUrl))
        {
            <img src="@Model.PictureUrl" alt="@Model.Name floor plan" class="w-100 h-100" style="object-fit: contain;" />
        }
        else
        {
            <div class="h-100 d-flex
                align-items-center
                justify-content-center">

                <div class="text-center text-muted">

                    <i class="bi bi-grid-3x3-gap" style="font-size: 4rem;">
                    </i>

                    <div class="mt-2">
                        No floor plan image
                    </div>

                </div>

            </div>
        }

    </div>


    <!-- Details -->
    <div class="card-body p-4">

        <h5 class="card-title fw-bold mb-3">
            @Model.Name
        </h5>


        <!-- Property Features -->
        <div class="row g-2 mb-4">

            <div class="col-4">

                <div class="border rounded
                    text-center p-2">

                    <i class="bi bi-door-open
                    text-primary d-block
                    mb-1"></i>

                    <div class="fw-bold">
                        @Model.Bedrooms
                    </div>

                    <div class="small text-muted">
                        Bedroom@(Model.Bedrooms == 1 ? "" : "s")
                    </div>

                </div>

            </div>


            <div class="col-4">

                <div class="border rounded
                    text-center p-2">

                    <i class="bi bi-droplet
                    text-primary d-block
                    mb-1"></i>

                    <div class="fw-bold">
                        @Model.Bathrooms
                    </div>

                    <div class="small text-muted">
                        Bathroom@(Model.Bathrooms == 1 ? "" : "s")
                    </div>

                </div>

            </div>


            <div class="col-4">

                <div class="border rounded
                    text-center p-2">

                    <i class="bi bi-rulers
                    text-primary d-block
                    mb-1"></i>

                    <div class="fw-bold">
                        @Model.SquareFeet.ToString("N0")
                    </div>

                    <div class="small text-muted">
                        Sq Ft
                    </div>

                </div>

            </div>

        </div>


        <!-- Rent -->
        <div class="d-flex
            justify-content-between
            align-items-end
            border-top
            pt-3">

            <div>

                <div class="small text-muted">
                    Monthly Rent
                </div>

                <div class="fs-4 fw-bold text-primary">
                    @Model.Rent.ToString("C0")
                </div>

                <div class="small text-muted">
                    per month
                </div>

            </div>


            <a asp-controller="RentalApplication" asp-action="Index" asp-route-id="@Model.FloorPlanId"
               class="btn btn-outline-primary">
                View Details
            </a>

        </div>

    </div>

</div>
@model IEnumerable<FloorPlanModel>

@{
    ViewData["Title"] = "Floor Plans";
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between
        align-items-md-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Floor Plans</h2>

            <p class="text-muted mb-0">
                Explore our available apartment floor plans.
            </p>
        </div>

        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Manager"))
        {
            <div class="mt-3 mt-md-0">
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>
                    Add Floor Plan
                </a>
            </div>
        }

    </div>


    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var floorPlan in Model)
            {
                <div class="col-md-6 col-lg-4">
                    @await Html.PartialAsync("_FloorPlansView", floorPlan)
                </div>
            }

        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <i class="bi bi-grid-3x3-gap
                    text-muted" style="font-size: 5rem;">
                </i>

                <h4 class="mt-3">
                    No Floor Plans
                </h4>

                <p class="text-muted">
                    There are currently no floor plans available.
                </p>

                <a asp-action="Create" class="btn btn-primary">

                    <i class="bi bi-plus-lg me-1"></i>
                    Add Floor Plan

                </a>

            </div>

        </div>
    }

</div>
@page
@model DetailsModel

@{
    ViewData["Title"] = "Account Details";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-white text-primary
                            d-flex align-items-center justify-content-center
                            me-3" style="width: 50px; height: 50px;">
                            <i class="bi bi-person-fill fs-4"></i>
                        </div>

                        <div>
                            <h4 class="mb-0">Account Details</h4>
                            <small class="opacity-75">
                                View your account information
                            </small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">

                    <div class="row g-4">

                        <!-- Full Name -->
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1">
                                Full Name
                            </label>

                            <div class="fw-semibold">
                                @(Model.UserAccount?.FullName)
                            </div>
                        </div>

                        <!-- Username -->
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1">
                                Username
                            </label>

                            <div class="fw-semibold">
                                @(Model.UserAccount?.UserName)
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1">
                                Email Address
                            </label>

                            <div class="fw-semibold">
                                @(Model.UserAccount?.Email)
                            </div>
                        </div>

                        <!-- Phone -->
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1">
                                Phone Number
                            </label>

                            <div class="fw-semibold">
                                @(Model.UserAccount?.PhoneNumber)
                            </div>
                        </div>

                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-page="/Account/Manage/Index" asp-area="Identity" class="btn btn-primary">
                            <i class="bi bi-pencil me-1"></i>
                            Edit Account
                        </a>

                        <a asp-page="/Account/Manage/Email" asp-area="Identity" class="btn btn-outline-secondary">
                            <i class="bi bi-envelope me-1"></i>
                            Change Email
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>